# Test local (copier en .env). En prod = GitHub Secrets (passés via toJSON(secrets)).
# Aucun mot de passe Fantrax : uniquement des cookies (storageState) et des clés/URLs.

# --- Auth Fantrax par compte (storageState). En local : chemin de fichier accepté. ---
FANTRAX_STATE_MAIN=./fantrax_state.json

# --- Notifs (webhooks) ---
SLACK_WEBHOOK_MAIN=
DISCORD_WEBHOOK_MAIN=

# --- Proxy résidentiel (Spotrac, anti-bot IP datacenter) ---
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Triage des remontées Discord (src/triage.mjs) ---
DISCORD_BOT_TOKEN=
ANTHROPIC_API_KEY=
